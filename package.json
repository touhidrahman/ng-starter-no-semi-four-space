{
    "name": "ng-starter-no-semi-four-space",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "dev": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "preinstall": "npx only-allow pnpm",
        "prepare": "pnpm lefthook install",
        "lint": "biome lint ./src --fix --skip=suspicious/noExplicitAny",
        "lint:unsafe": "biome lint ./src --skip=suspicious/noExplicitAny --fix --unsafe",
        "f1": "biome check . --write --unsafe --diagnostic-level=error",
        "f2": "prettier --write 'src/**/*.{html,xml,scss}'",
        "f": "pnpm f1 && pnpm f2",
        "format": "pnpm f1 && pnpm f2",
        "ng-update": "ng update @angular/core @angular/cli @angular/cdk @schematics/angular --allow-dirty",
        "ng-remove-unused-imports": "ng generate @angular/core:cleanup-unused-imports",
        "ng-control-flow": "ng generate @angular/core:control-flow",
        "ng-use-inject": "ng generate @angular/core:inject",
        "ng-use-signal-input": "ng generate @angular/core:signal-input-migration",
        "make-env-file": "tsc src/environments/make-env-file.ts && node src/environments/make-env-file.js && rm src/environments/make-env-file.js",
        "spartan:theme": "ng g @spartan-ng/cli:ui-theme",
        "spartan:ui": "ng g @spartan-ng/cli:ui",
        "spartan:update": "ng g @spartan-ng/cli:migrate-helm-libraries"
    },
    "dependencies": {
        "@angular/animations": "^20.3.6",
        "@angular/cdk": "^20.2.9",
        "@angular/common": "^20.3.6",
        "@angular/compiler": "^20.3.6",
        "@angular/core": "^20.3.6",
        "@angular/forms": "^20.3.6",
        "@angular/platform-browser": "^20.3.6",
        "@angular/platform-browser-dynamic": "^20.3.6",
        "@angular/router": "^20.3.6",
        "@auth0/angular-jwt": "^5.2.0",
        "@date-io/date-fns": "^3.2.1",
        "@ng-icons/core": "^32.2.0",
        "@ng-icons/heroicons": "^32.2.0",
        "@ng-icons/lucide": "^32.1.0",
        "@ng-web-apis/common": "^4.12.2",
        "@ngneat/dialog": "^5.2.0",
        "@spartan-ng/brain": "0.0.1-alpha.533",
        "@tailwindcss/postcss": "^4.1.14",
        "appwrite": "^21.2.1",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "date-fns-tz": "^3.2.0",
        "destr": "^2.0.5",
        "embla-carousel-angular": ">=19.0.0",
        "es-toolkit": "^1.40.0",
        "lefthook": "^1.13.6",
        "ng-primitives": "^0.84.0",
        "ngx-sonner": "^3.1.0",
        "primeicons": "^7.0.0",
        "qs": "^6.14.0",
        "radash": "^12.1.1",
        "rxjs": "~7.8.2",
        "tailwind-merge": "^2.5.2",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular-eslint/schematics": "^20.4.0",
        "@angular/build": "^20.3.6",
        "@angular/cli": "^20.3.6",
        "@angular/compiler-cli": "^20.3.6",
        "@biomejs/biome": "~2.2.6",
        "@schematics/angular": "^20.3.6",
        "@spartan-ng/cli": "0.0.1-alpha.533",
        "@types/node": "^24.8.0",
        "@types/qs": "^6.14.0",
        "autoprefixer": "^10.4.21",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-angular": "^5.0.0",
        "eslint-plugin-prettier": "^5.5.4",
        "postcss": "^8.5.6",
        "prettier": "^3.6.2",
        "prettier-plugin-tailwindcss": "^0.7.0",
        "tailwindcss": "^4.1.14",
        "tailwindcss-animate": "^1.0.6",
        "typescript": "~5.9.2"
    },
    "optionalDependencies": {
        "@biomejs/cli-darwin-x64": "~2.2.6",
        "@biomejs/cli-linux-x64": "~2.2.6",
        "@biomejs/cli-win32-x64": "~2.2.6"
    },
    "packageManager": "pnpm@10.18.0",
    "engines": {
        "node": ">=22.x"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@parcel/watcher",
            "@tailwindcss/oxide",
            "esbuild",
            "lefthook",
            "lmdb",
            "msgpackr-extract",
            "nx"
        ]
    }
}
